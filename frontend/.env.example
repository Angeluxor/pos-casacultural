# Copia este archivo a ".env.local" para desarrollo local.
# En Vercel se configura como variable de entorno del proyecto (Production/Preview).

# URL pública del backend, SIN barra final.
# Vacío = usa rutas relativas (proxy de Vite en desarrollo / mismo dominio).
# Ejemplo en producción: https://pos-casacultural-api.onrender.com
VITE_API_URL=

# Versión que se adjunta al contexto del feedback (opcional; vacío = "dev").
VITE_APP_VERSION=
