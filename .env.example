# Variables opcionales para "docker compose" (entorno LOCAL).
# Copia este archivo a ".env" en la raíz y ajusta lo que necesites.
# Si no creas el ".env", se usan los valores por defecto de aquí abajo.

# --- Postgres local ---
POSTGRES_USER=pos
POSTGRES_PASSWORD=pos
POSTGRES_DB=pos_casacultural

# --- Backend ---
SECRET_KEY=local-dev-secret-change-me
CORS_ORIGINS=http://localhost:5173
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
ADMIN_NOMBRE=Administrador

# --- Frontend ---
# URL del backend tal como la ve el NAVEGADOR (tu máquina).
VITE_API_URL=http://localhost:8000
