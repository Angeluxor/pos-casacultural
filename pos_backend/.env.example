# Copia este archivo a ".env.local" para desarrollo local.
# En producción estas variables se configuran en el panel del hosting.

# --- Base de datos (Neon) ---
# Cadena POOLADA: úsala para la app (connection pooling de Neon).
DATABASE_URL=postgresql://USUARIO:CLAVE@ep-xxxx-pooler.us-east-1.aws.neon.tech/neondb?sslmode=require
# Cadena SIN pooling: úsala solo para migraciones / DDL / scripts puntuales.
DATABASE_URL_UNPOOLED=postgresql://USUARIO:CLAVE@ep-xxxx.us-east-1.aws.neon.tech/neondb?sslmode=require

# --- Seguridad (JWT) ---
# Genera una cadena aleatoria larga, p. ej.: openssl rand -hex 32
SECRET_KEY=cambia-esta-clave-por-una-aleatoria-y-larga
ACCESS_TOKEN_EXPIRE_MINUTES=480

# --- CORS ---
# Dominios del frontend permitidos, separados por coma (sin barra final).
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Semilla del primer administrador (solo la primera vez) ---
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
ADMIN_NOMBRE=Administrador
