# Copia este archivo a ".env.local" para desarrollo local.
# En producción estas variables se configuran en el panel del hosting.

# --- Base de datos (Neon) ---
# Cadena POOLADA: úsala para la app (connection pooling de Neon).
DATABASE_URL=postgresql://USUARIO:CLAVE@ep-xxxx-pooler.us-east-1.aws.neon.tech/neondb?sslmode=require
# Cadena SIN pooling: úsala solo para migraciones / DDL / scripts puntuales.
DATABASE_URL_UNPOOLED=postgresql://USUARIO:CLAVE@ep-xxxx.us-east-1.aws.neon.tech/neondb?sslmode=require

# --- Seguridad (JWT) ---
# Genera una cadena aleatoria larga, p. ej.: openssl rand -hex 32
SECRET_KEY=cambia-esta-clave-por-una-aleatoria-y-larga
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Entorno de ejecución: "development" (por defecto) o "production".
# En production se exige una SECRET_KEY propia (no la de desarrollo) y se
# activan HSTS; en development se omite para no romper http://localhost.
ENVIRONMENT=development

# --- Endurecimiento de contraseñas ---
# Rondas de bcrypt (más rondas = más resistencia a fuerza bruta y más CPU).
BCRYPT_ROUNDS=12
# Longitud mínima exigida para las contraseñas.
PASSWORD_MIN_LENGTH=8

# --- Rate limiting (en memoria, por IP) ---
LOGIN_MAX_ATTEMPTS=10
LOGIN_WINDOW_SECONDS=60
GLOBAL_MAX_REQUESTS=600
GLOBAL_WINDOW_SECONDS=60

# --- CORS ---
# Dominios del frontend permitidos, separados por coma (sin barra final).
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Semilla del primer administrador (solo la primera vez) ---
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
ADMIN_NOMBRE=Administrador

# --- Avisos de feedback por Telegram (opcional) ---
# Si ambos están vacíos, no se envían avisos y el feedback sigue funcionando.
# 1. Crea un bot con @BotFather y copia el token.
# 2. Envía un mensaje al bot y consulta su chat ID.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# URL pública del frontend para el enlace «Ver bandeja» del mensaje.
FRONTEND_URL=https://pos-casacultural.vercel.app
